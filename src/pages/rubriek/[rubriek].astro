---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Voorlezen from '../../components/Voorlezen.astro';
import Galerij from '../../components/Galerij.astro';
import Model from '../../components/Model.astro';
import { rubrieken, datumNL } from '../../rubrieken.js';

export async function getStaticPaths() {
  const alles = await getCollection('nieuws');
  return Object.keys(rubrieken).map((r) => ({
    params: { rubriek: r },
    props: {
      sleutel: r,
      items: alles
        .filter((a) => a.data.rubriek === r)
        .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf()),
    },
  }));
}

const { sleutel, items } = Astro.props;
const r = rubrieken[sleutel];
const galerij = r.galerij ?? [];
const uitgelicht = r.uitgelicht ?? [];
---

<Base titel={`${r.naam} — Stoomtrein Vandaag`} compact={true}>

  <img class="artikelfoto" src={r.foto} alt="" />
  <p class="credit">{r.fotoCredit}</p>

  <h1 class="rubriektitel">{r.naam}</h1>

  <div class="intro" id="voorlezen">
    {r.intro.map((p) => <p>{p}</p>)}
  </div>

  {r.feiten.length > 0 && (
    <dl class="feiten">
      {r.feiten.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
    </dl>
  )}

  {r.model && (
    <section class="blok">
      <h2 class="sectiekop">Draai hem rond</h2>
      <Model bestand={r.model} titel={r.naam} />
      <p class="credit">{r.modelCredit}</p>
    </section>
  )}

  {galerij.length > 0 && (
    <section class="blok">
      <h2 class="sectiekop">Foto's</h2>
      <Galerij fotos={galerij} />
    </section>
  )}

  {uitgelicht.length > 0 && (
    <section class="blok">
      <h2 class="sectiekop">Om te doen</h2>
      <div class="doenraster">
        {uitgelicht.map((u) => (
          u.link ? (
            <a class="doenkaart" href={u.link}>
              {u.foto && <img src={u.foto} alt="" />}
              <div class="inhoud">
                <h3>{u.titel}</h3>
                <p>{u.tekst}</p>
              </div>
            </a>
          ) : (
            <div class="doenkaart straks">
              {u.foto && <img src={u.foto} alt="" />}
              <div class="inhoud">
                <h3>{u.titel}</h3>
                <p>{u.tekst}</p>
                <span class="binnenkort">Binnenkort</span>
              </div>
            </div>
          )
        ))}
      </div>
    </section>
  )}

  {items.length > 0 ? (
    <section class="blok">
      <h2 class="sectiekop">Verhalen</h2>
      <div class="raster">
        {items.map((a) => (
          <a class="kaart" href={`/nieuws/${a.id}/`}>
            <img src={a.data.afbeelding} alt="" />
            <div class="inhoud">
              <h3>{a.data.titel}</h3>
              <span class="datum">{datumNL(a.data.datum)}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ) : (
    <p class="leeg">Hier komen binnenkort verhalen te staan.</p>
  )}

  <nav class="balk">
    <a class="knop stil klein" href="/">&larr; Terug</a>
    <div class="rechts">
      <button class="knop stil klein verborgen" id="stop">Stop</button>
      <button class="knop klein" id="lees">Lees voor</button>
    </div>
  </nav>

</Base>

<Voorlezen />
