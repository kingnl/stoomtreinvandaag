---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { rubrieken, datumNL } from '../../rubrieken.js';

export async function getStaticPaths() {
  const items = await getCollection('nieuws');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;

const alles = await getCollection('nieuws');
const serie = d.serie
  ? alles.filter((a) => a.data.serie === d.serie).sort((a, b) => (a.data.deel ?? 0) - (b.data.deel ?? 0))
  : [];
const hier = serie.findIndex((a) => a.id === item.id);
const volgende = hier >= 0 ? serie[hier + 1] : null;
const vorige = hier > 0 ? serie[hier - 1] : null;

const embed = d.video
  ? `https://www.youtube-nocookie.com/embed/${d.video}?autoplay=1&mute=1&loop=1&playlist=${d.video}&controls=0&modestbranding=1&rel=0&playsinline=1&disablekb=1`
  : null;
---

<Base titel={`${d.titel} — Stoomtrein Vandaag`} compact={true}>

  {embed ? (
    <div class="media">
      <iframe src={embed} title={d.titel} allow="autoplay; encrypted-media; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe>
      <div class="mediaschild"></div>
    </div>
  ) : (
    <img class="media-foto" src={d.afbeelding} alt="" />
  )}

  <article class="artikel">
    <span class="merk" data-r={d.rubriek}>{rubrieken[d.rubriek].naam}</span>
    {d.serie && <span class="deelmerk">Deel {d.deel} van {serie.length}</span>}

    <h1>{d.titel}</h1>

    {d.audio && <audio class="speler" controls preload="none" src={d.audio}></audio>}

    <div id="voorlezen">
      <Content />
    </div>

    {volgende && (
      <a class="knop breed" href={`/nieuws/${volgende.id}/`}>
        Verder met deel {volgende.data.deel} &rarr;
      </a>
    )}
    {vorige && (
      <a class="knop stil breed" href={`/nieuws/${vorige.id}/`}>
        &larr; Terug naar deel {vorige.data.deel}
      </a>
    )}

    {d.video && (
      <a class="knop stil breed" href={`https://www.youtube.com/watch?v=${d.video}`} target="_blank" rel="noopener">
        Bekijk op YouTube
      </a>
    )}

    <p class="bronregel">
      {d.bron && (
        <>
          Bron:{' '}
          {d.bron.url
            ? <a class="bronlink" href={d.bron.url} rel="noopener nofollow" target="_blank">{d.bron.naam}</a>
            : d.bron.naam}
          {d.bron.datum ? `, ${d.bron.datum}` : ''}
          <br />
        </>
      )}
      {d.video ? d.videoCredit : d.afbeeldingCredit}
      <br />
      Geplaatst op {datumNL(d.datum)}
    </p>
  </article>

  <nav class="balk">
    <a class="knop stil klein" href="/">&larr; Terug</a>
    <div class="rechts">
      <button class="knop stil klein verborgen" id="stop">Stop</button>
      <button class="knop klein" id="lees">Lees voor</button>
    </div>
  </nav>

</Base>

<script>
  const leesKnop = document.getElementById('lees');
  const stopKnop = document.getElementById('stop');
  const blok = document.getElementById('voorlezen');
  const kop = document.querySelector('.artikel h1');

  let rij = [];
  let index = 0;
  let actief = false;

  function stem() {
    const alle = window.speechSynthesis.getVoices();
    return alle.find((s) => s.lang === 'nl-NL' && /premium|enhanced|verbeterd/i.test(s.name)) ||
           alle.find((s) => s.lang === 'nl-NL') ||
           alle.find((s) => s.lang && s.lang.startsWith('nl')) || null;
  }

  // Tekst opdelen in losse zinnen, met een langere pauze na elke alinea
  function bouwRij() {
    const stukken = [];
    if (kop) stukken.push({ tekst: kop.innerText, pauze: 700 });

    blok.querySelectorAll('p, li').forEach((el) => {
      const alinea = el.innerText.trim();
      if (!alinea) return;
      const zinnen = alinea.match(/[^.!?]+[.!?]*/g) || [alinea];
      zinnen.forEach((z, i) => {
        const t = z.trim();
        if (t) stukken.push({ tekst: t, pauze: i === zinnen.length - 1 ? 650 : 280 });
      });
    });
    return stukken;
  }

  function klaar() {
    actief = false;
    leesKnop.textContent = 'Lees voor';
    stopKnop.classList.add('verborgen');
  }

  function spreekVolgende() {
    if (!actief || index >= rij.length) { klaar(); return; }
    const stuk = rij[index];
    const u = new SpeechSynthesisUtterance(stuk.tekst);
    const v = stem();
    u.lang = 'nl-NL';
    if (v) u.voice = v;
    u.rate = 0.85;
    u.pitch = 1.0;
    u.onend = () => {
      index++;
      setTimeout(spreekVolgende, stuk.pauze);
    };
    u.onerror = () => { index++; setTimeout(spreekVolgende, 120); };
    window.speechSynthesis.speak(u);
  }

  function voorlezen() {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    rij = bouwRij();
    index = 0;
    actief = true;
    leesKnop.textContent = 'Opnieuw';
    stopKnop.classList.remove('verborgen');
    setTimeout(spreekVolgende, 60);
  }

  leesKnop.addEventListener('click', voorlezen);
  stopKnop.addEventListener('click', () => { actief = false; window.speechSynthesis.cancel(); klaar(); });

  if ('speechSynthesis' in window) {
    window.speechSynthesis.getVoices();
    window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
  }
</script>
