---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Voorlezen from '../../components/Voorlezen.astro';
import { rubrieken, datumNL } from '../../rubrieken.js';

export async function getStaticPaths() {
  const items = await getCollection('nieuws');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
---

<Base titel={`${d.titel} — Stoomtrein Vandaag`}>
  <a class="terug" href="/">&larr; Terug naar het overzicht</a>

  <article class="artikel">
    <img class="artikelfoto" src={d.afbeelding} alt="" />
    <p class="credit">{d.afbeeldingCredit}</p>

    <span class="merk" data-r={d.rubriek}>{rubrieken[d.rubriek].naam}</span>
    <h1>{d.titel}</h1>

    {d.audio && (
      <audio id="speler" controls preload="none" src={d.audio}></audio>
    )}

    <div id="voorlezen">
      <Content />
    </div>

    <p class="bronregel">
      {d.bron && (
        <>
          Bron:{' '}
          {d.bron.url
            ? <a class="bronlink" href={d.bron.url} rel="noopener nofollow" target="_blank">{d.bron.naam}</a>
            : d.bron.naam}
          {d.bron.datum ? `, ${d.bron.datum}` : ''}
          <br />
        </>
      )}
      {d.afbeeldingCredit}
      <br />
      Geplaatst op {datumNL(d.datum)}
    </p>
  </article>

  <Voorlezen />
</Base>
